+#[test]
+fn permission_overrides_replace_selected_fragments() {
+    let catalog_messages = ApprovalMessages {
+        on_request: Some("catalog request rule".to_string()),
+        on_request_auto_review: Some("catalog auto-review rule".to_string()),
+        never: None,
+        unless_trusted: None,
+    };
+    let text = approval_text_with_overrides(
+        AskForApproval::OnRequest,
+        ApprovalsReviewer::AutoReview,
+        Some(&catalog_messages),
+        &Policy::empty(),
+        /*exec_permission_approvals_enabled*/ true,
+        /*request_permissions_tool_enabled*/ true,
+        PermissionsInstructionOverrides {
+            approval_policy_on_request_rule_request_permission: Some("custom request rule"),
+            request_permissions_tool: Some("custom request permissions tool"),
+            auto_review_approval_suffix: Some("custom auto review suffix"),
+            ..Default::default()
+        },
+    );
+
+    assert_eq!(
+        text,
+        [
+            "custom request rule",
+            "custom request permissions tool",
+            "custom auto review suffix",
+        ]
+        .join("\n\n")
+    );
+}
