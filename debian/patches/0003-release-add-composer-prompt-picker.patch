diff --git a/codex-rs/tui/src/prompt_files.rs b/codex-rs/tui/src/prompt_files.rs
new file mode 100644
index 000000000..5aaf005ca
--- /dev/null
+++ b/codex-rs/tui/src/prompt_files.rs
@@ -0,0 +1,216 @@
+use codex_protocol::user_input::MAX_USER_INPUT_TEXT_CHARS;
+use std::fs;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub(crate) const PROMPT_FILES_DIR_NAME: &str = ".prompt";
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct PromptFile {
+    pub(crate) name: String,
+    pub(crate) description: Option<String>,
+    pub(crate) content: Option<String>,
+    pub(crate) disabled_reason: Option<String>,
+}
+
+pub(crate) fn prompt_files_dir(codex_home: &Path) -> PathBuf {
+    codex_home.join(PROMPT_FILES_DIR_NAME)
+}
+
+pub(crate) fn discover_prompt_files(codex_home: &Path) -> Vec<PromptFile> {
+    let dir = prompt_files_dir(codex_home);
+    let Ok(entries) = fs::read_dir(&dir) else {
+        return Vec::new();
+    };
+
+    let mut prompts = Vec::new();
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let Ok(metadata) = entry.metadata() else {
+            continue;
+        };
+        if !metadata.is_file() || !is_markdown_file(&path) {
+            continue;
+        }
+        let Some(name) = path.file_stem().and_then(|stem| stem.to_str()) else {
+            continue;
+        };
+
+        let (description, content, disabled_reason) = match fs::read_to_string(&path) {
+            Ok(file_text) => {
+                let (description, prompt_text) = split_prompt_description(&file_text);
+                let char_count = prompt_text.chars().count();
+                if char_count == 0 {
+                    (
+                        description,
+                        None,
+                        Some("Prompt is empty after removing the description comment.".to_string()),
+                    )
+                } else if char_count > MAX_USER_INPUT_TEXT_CHARS {
+                    (
+                        description,
+                        None,
+                        Some(format!(
+                            "Prompt exceeds the maximum composer length of {MAX_USER_INPUT_TEXT_CHARS} characters."
+                        )),
+                    )
+                } else {
+                    (description, Some(prompt_text), None)
+                }
+            }
+            Err(err) => (None, None, Some(format!("Prompt could not be read: {err}"))),
+        };
+
+        prompts.push(PromptFile {
+            name: name.to_string(),
+            description,
+            content,
+            disabled_reason,
+        });
+    }
+
+    prompts.sort_by(|left, right| left.name.cmp(&right.name));
+    prompts
+}
+
+fn is_markdown_file(path: &Path) -> bool {
+    path.extension()
+        .and_then(|ext| ext.to_str())
+        .is_some_and(|ext| ext.eq_ignore_ascii_case("md"))
+}
+
+fn split_prompt_description(file_text: &str) -> (Option<String>, String) {
+    let Some(comment_body) = file_text.strip_prefix("<!--") else {
+        return (None, file_text.to_string());
+    };
+    let Some(comment_end) = comment_body.find("-->") else {
+        return (None, file_text.to_string());
+    };
+
+    let raw_description = &comment_body[..comment_end];
+    let description = normalize_description(raw_description);
+    let remaining = &comment_body[comment_end + 3..];
+    let prompt_text = remaining
+        .strip_prefix("\r\n")
+        .or_else(|| remaining.strip_prefix('\n'))
+        .or_else(|| remaining.strip_prefix('\r'))
+        .unwrap_or(remaining)
+        .to_string();
+    (description, prompt_text)
+}
+
+fn normalize_description(raw_description: &str) -> Option<String> {
+    let normalized = raw_description
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty())
+        .collect::<Vec<_>>()
+        .join(" ");
+    (!normalized.is_empty()).then_some(normalized)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::PROMPT_FILES_DIR_NAME;
+    use super::discover_prompt_files;
+    use codex_protocol::user_input::MAX_USER_INPUT_TEXT_CHARS;
+    use pretty_assertions::assert_eq;
+    use std::fs;
+    use tempfile::tempdir;
+
+    #[test]
+    fn discover_prompt_files_lists_markdown_without_extensions() {
+        let codex_home = tempdir().expect("temp codex home");
+        let prompt_dir = codex_home.path().join(PROMPT_FILES_DIR_NAME);
+        fs::create_dir_all(&prompt_dir).expect("create prompt dir");
+        fs::write(prompt_dir.join("zeta.md"), "zeta").expect("write zeta");
+        fs::write(prompt_dir.join("alpha.md"), "alpha").expect("write alpha");
+        fs::write(prompt_dir.join("skip.txt"), "skip").expect("write txt");
+
+        let prompts = discover_prompt_files(codex_home.path());
+
+        assert_eq!(
+            prompts
+                .into_iter()
+                .map(|prompt| {
+                    (
+                        prompt.name,
+                        prompt.description,
+                        prompt.content,
+                        prompt.disabled_reason,
+                    )
+                })
+                .collect::<Vec<_>>(),
+            vec![
+                ("alpha".to_string(), None, Some("alpha".to_string()), None),
+                ("zeta".to_string(), None, Some("zeta".to_string()), None),
+            ]
+        );
+    }
+
+    #[test]
+    fn discover_prompt_files_uses_top_html_comment_as_description() {
+        let codex_home = tempdir().expect("temp codex home");
+        let prompt_dir = codex_home.path().join(PROMPT_FILES_DIR_NAME);
+        fs::create_dir_all(&prompt_dir).expect("create prompt dir");
+        fs::write(
+            prompt_dir.join("review.md"),
+            "<!-- Review current diff for regressions. -->\nReview this diff.\n",
+        )
+        .expect("write prompt");
+
+        let prompts = discover_prompt_files(codex_home.path());
+
+        assert_eq!(prompts.len(), 1);
+        assert_eq!(prompts[0].name, "review");
+        assert_eq!(
+            prompts[0].description.as_deref(),
+            Some("Review current diff for regressions.")
+        );
+        assert_eq!(prompts[0].content.as_deref(), Some("Review this diff.\n"));
+        assert_eq!(prompts[0].disabled_reason, None);
+    }
+
+    #[test]
+    fn discover_prompt_files_disables_empty_prompt_after_comment() {
+        let codex_home = tempdir().expect("temp codex home");
+        let prompt_dir = codex_home.path().join(PROMPT_FILES_DIR_NAME);
+        fs::create_dir_all(&prompt_dir).expect("create prompt dir");
+        fs::write(prompt_dir.join("empty.md"), "<!-- Description only -->\n")
+            .expect("write prompt");
+
+        let prompts = discover_prompt_files(codex_home.path());
+
+        assert_eq!(prompts.len(), 1);
+        assert_eq!(prompts[0].name, "empty");
+        assert_eq!(prompts[0].content, None);
+        assert_eq!(
+            prompts[0].disabled_reason.as_deref(),
+            Some("Prompt is empty after removing the description comment.")
+        );
+    }
+
+    #[test]
+    fn discover_prompt_files_marks_oversized_prompts_disabled() {
+        let codex_home = tempdir().expect("temp codex home");
+        let prompt_dir = codex_home.path().join(PROMPT_FILES_DIR_NAME);
+        fs::create_dir_all(&prompt_dir).expect("create prompt dir");
+        let oversized = format!(
+            "<!-- desc -->\n{}",
+            "x".repeat(MAX_USER_INPUT_TEXT_CHARS + 1)
+        );
+        fs::write(prompt_dir.join("oversized.md"), oversized).expect("write oversized");
+
+        let prompts = discover_prompt_files(codex_home.path());
+
+        assert_eq!(prompts.len(), 1);
+        assert_eq!(prompts[0].name, "oversized");
+        assert_eq!(prompts[0].content, None);
+        assert_eq!(
+            prompts[0].disabled_reason,
+            Some(format!(
+                "Prompt exceeds the maximum composer length of {MAX_USER_INPUT_TEXT_CHARS} characters."
+            ))
+        );
+    }
+}
