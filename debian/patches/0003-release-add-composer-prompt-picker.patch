@@ -0,0 +1,216 @@
+use codex_protocol::user_input::MAX_USER_INPUT_TEXT_CHARS;
+use std::fs;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub(crate) const PROMPT_FILES_DIR_NAME: &str = ".prompt";
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct PromptFile {
+    pub(crate) name: String,
+    pub(crate) description: Option<String>,
+    pub(crate) content: Option<String>,
+    pub(crate) disabled_reason: Option<String>,
+}
+
+pub(crate) fn prompt_files_dir(codex_home: &Path) -> PathBuf {
+    codex_home.join(PROMPT_FILES_DIR_NAME)
+}
+
+pub(crate) fn discover_prompt_files(codex_home: &Path) -> Vec<PromptFile> {
+    let dir = prompt_files_dir(codex_home);
+    let Ok(entries) = fs::read_dir(&dir) else {
+        return Vec::new();
+    };
+
+    let mut prompts = Vec::new();
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let Ok(metadata) = entry.metadata() else {
+            continue;
+        };
+        if !metadata.is_file() || !is_markdown_file(&path) {
+            continue;
+        }
+        let Some(name) = path.file_stem().and_then(|stem| stem.to_str()) else {
+            continue;
+        };
+
+        let (description, content, disabled_reason) = match fs::read_to_string(&path) {
+            Ok(file_text) => {
+                let (description, prompt_text) = split_prompt_description(&file_text);
+                let char_count = prompt_text.chars().count();
+                if char_count == 0 {
+                    (
+                        description,
+                        None,
+                        Some("Prompt is empty after removing the description comment.".to_string()),
+                    )
+                } else if char_count > MAX_USER_INPUT_TEXT_CHARS {
+                    (
+                        description,
+                        None,
+                        Some(format!(
+                            "Prompt exceeds the maximum composer length of {MAX_USER_INPUT_TEXT_CHARS} characters."
+                        )),
+                    )
+                } else {
+                    (description, Some(prompt_text), None)
+                }
+            }
+            Err(err) => (None, None, Some(format!("Prompt could not be read: {err}"))),
+        };
+
+        prompts.push(PromptFile {
+            name: name.to_string(),
+            description,
+            content,
+            disabled_reason,
+        });
+    }
+
+    prompts.sort_by(|left, right| left.name.cmp(&right.name));
+    prompts
+}
+
+fn is_markdown_file(path: &Path) -> bool {
+    path.extension()
+        .and_then(|ext| ext.to_str())
+        .is_some_and(|ext| ext.eq_ignore_ascii_case("md"))
+}
+
+fn split_prompt_description(file_text: &str) -> (Option<String>, String) {
+    let Some(comment_body) = file_text.strip_prefix("<!--") else {
+        return (None, file_text.to_string());
+    };
+    let Some(comment_end) = comment_body.find("-->") else {
+        return (None, file_text.to_string());
+    };
+
+    let raw_description = &comment_body[..comment_end];
+    let description = normalize_description(raw_description);
+    let remaining = &comment_body[comment_end + 3..];
+    let prompt_text = remaining
+        .strip_prefix("\r\n")
+        .or_else(|| remaining.strip_prefix('\n'))
+        .or_else(|| remaining.strip_prefix('\r'))
+        .unwrap_or(remaining)
+        .to_string();
+    (description, prompt_text)
+}
+
+fn normalize_description(raw_description: &str) -> Option<String> {
+    let normalized = raw_description
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty())
+        .collect::<Vec<_>>()
+        .join(" ");
+    (!normalized.is_empty()).then_some(normalized)
+}
+
